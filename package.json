  "type": "module",
  "scripts": {
    "astro": "astro",
    "bootstrap": "yarn bootstrap:icons && yarn bootstrap:astro",
    "bootstrap:astro": "astro sync",
    "bootstrap:icons": "node ./scripts/iconify.ts",
    "build": "astro build",
    "check": "oxlint --type-aware --type-check && astro build",

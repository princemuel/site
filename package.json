    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "astro dev",
    "lint": "yarn lint:scripts && yarn lint:astro",
    "lint:astro": "astro check",
    "lint:scripts": "oxlint",
    "preview": "astro preview",
    "start": "astro dev",
    "typecheck": "tsc --noEmit"
  },

// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.vercel.app/docs/configuring-zed#settings-files
{
  "format_on_save": "on",
  "prettier": { "allowed": true },
  "lsp": {
    "astro-language-server": { "settings": {} },
    "mdx-analyzer": { "initialization_options": { "typescript": { "enabled": true } } },
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": "./oxlint.config.mts",
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny",
        },
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": { "astro": "html" },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class:list=\"{([^}]*)}\"",
            "class:list='{([^}]*)}'",
          ],
        },
      },
    },
    "typescript-ls": { "settings": { "package_version": "7.0.2" } },
  },
  "languages": {
    "Astro": {
      "language_servers": [
        "astro",
        "typescript-ls",
        "oxlint",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "...",
      ],
    },
    "JavaScript": {
      "language_servers": [
        "typescript-ls",
        "oxlint",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "...",
      ],
    },
    "TypeScript": {
      "language_servers": [
        "typescript-ls",
        "oxlint",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "...",
      ],
    },
    "TSX": {
      "language_servers": [
        "typescript-ls",
        "oxlint",
        "!vtsls",
        "!typescript-language-server",
        "!eslint",
        "...",
      ],
    },
    "CSS": {
      "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "..."],
    },
    "JSON": {},
    "JSONC": {},
    "Markdown": {},
    "Markdown-Inline": {},
    "MDX": {},
    "YAML": {},
  },
}

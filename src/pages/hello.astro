---
import Prose from "@/components/content/prose.astro";
import Shell from "@/components/frames/shell.astro";
import Icon from "@/components/shared/icon.astro";
import Link from "@/components/shared/link.astro";
import Pot from "@/components/widgets/pot.astro";
import { getCollection, getEntry, render } from "astro:content";

import { println$ } from "@/helpers/println";
import { toRobotsObject } from "@/helpers/robots";
import { ACTION_QUERY_PARAMS, actions, isInputError } from "astro:actions";

export const prerender = false;

const entry = await getEntry("documents", "hello");
if (!entry) throw new Response(undefined, { status: 404 });

const excluded = new Set(["website", "rss", "instagram", "mastodon", "keyoxide"]);
const [{ Content }, socials] = await Promise.all([
  render(entry),
  getCollection("socials", (social) => !excluded.has(social.id)),
]);
socials.sort((a, b) => a.data.order - b.data.order);

const result = Astro.getActionResult(actions.contact);

println$("[ERROR]", result?.error);

const formErrors = isInputError(result?.error) ? result.error.fields : {};

if (!result?.error && result?.data?.message) {
  const url = Astro.url.searchParams;
  url.delete(ACTION_QUERY_PARAMS.actionName);
  url.delete(ACTION_QUERY_PARAMS.actionPayload);
  return Astro.redirect(url, 303);
}

const { title, description, headline, date, robots, updated, language, permalink } = entry.data;
---

<Shell
  meta={{
    title: [title],
    description,
    date,
    updated,
    robots: toRobotsObject(robots),
    language,
    canonical: permalink,
  }}
>
  <Prose as="header">
    <h1 id="a11ty-headline" class="">{headline}</h1>
    <Content frontmatter={entry.data} />
  </Prose>

  <address class="flex items-center gap-4 text-2xl">
    {
      socials.map((r) => (
        <Link href={r.data.href} class:list={["transition", r.data.color ?? "text-current"]}>
          <Icon name={r.data.icon} title={r.data.text} class="text-current" />
        </Link>
      ))
    }
  </address>

  <hr class="text-gray-200 dark:text-gray-800" />

  <Prose as="section" class="space-y-5" aria-labelledby="contact-me">
    <h2 id="contact-me">Get in touch with moi</h2>
    <p>Let me know what's on your mind and I'll get back to you as soon as possible.</p>

    <form method="POST" action={actions.contact} class="flex flex-col gap-6 md:gap-8">
      <section class="grid grid-cols-6 gap-5">
        <Pot name="token" />
        <div class="group col-span-full flex flex-col gap-2 sm:col-span-3">
          <label
            class="space-x-1 text-sm font-medium text-gray-600 dark:text-gray-100"
            for="fields.firstName.input"
          >
            <span>First Name</span><span class="text-red-400">*</span>
          </label>

          <input
            type="text"
            id="fields.firstName.input"
            name="firstName"
            aria-autocomplete="both"
            class="rounded border border-gray-500 bg-transparent px-4 py-3 text-gray-900 dark:text-white"
            autocomplete="given-name"
            aria-invalid={Boolean(formErrors?.firstName)}
            aria-errormessage="fields.firstName.error"
          />

          <span
            role="alert"
            aria-live="polite"
            aria-atomic="true"
            aria-relevant="all"
            class="text-sm text-red-400"
            id="fields.firstName.error"
          >
            {formErrors?.firstName?.join(" ")}
          </span>
        </div>

        <div class="group col-span-full flex flex-col gap-2 sm:col-span-3">
          <label
            for="fields.lastName.input"
            class="space-x-1 text-sm font-medium text-gray-600 dark:text-gray-100"
          >
            <span>Last Name</span><span class="text-red-400">*</span>
          </label>
          <input
            type="text"
            id="fields.lastName.input"
            name="lastName"
            aria-autocomplete="both"
            class="rounded border border-gray-500 bg-transparent px-4 py-3 text-gray-900 dark:text-white"
            autocomplete="family-name"
            aria-invalid={Boolean(formErrors?.lastName)}
            aria-errormessage="fields.lastName.error"
          />
          <span
            role="alert"
            aria-live="polite"
            aria-atomic="true"
            aria-relevant="all"
            class="text-sm text-red-400"
            id="fields.lastName.error"
          >
            {formErrors?.lastName?.join(" ")}
          </span>
        </div>

        <div class="group col-span-full flex flex-col gap-2">
          <label
            for="fields.email.input"
            class="space-x-1 text-sm font-medium text-gray-600 dark:text-gray-100"
          >
            <span>Email Address</span><span class="text-red-400">*</span>
          </label>
          <input
            type="email"
            id="fields.email.input"
            name="email"
            aria-autocomplete="both"
            class="rounded border border-gray-500 bg-transparent px-4 py-3 text-gray-900 dark:text-white"
            autocomplete="email"
            aria-invalid={Boolean(formErrors?.email)}
            aria-errormessage="fields.email.error"
          />
          <span
            role="alert"
            aria-live="polite"
            aria-atomic="true"
            aria-relevant="all"
            class="text-sm text-red-400"
            id="fields.email.error"
          >
            {formErrors?.email?.join(" ")}
          </span>
        </div>

        <fieldset class="group col-span-full space-y-3">
          <legend class="space-x-1 text-sm font-medium text-gray-600 dark:text-gray-100">
            Query Type <span class="text-red-400">*</span>
          </legend>

          <section class="grid grid-cols-6 gap-5">
            <label
              class="col-span-full flex items-center gap-2 rounded border border-gray-500 px-4 py-3 text-gray-900 sm:col-span-3 dark:text-white"
            >
              <input
                type="radio"
                id="fields.general.input"
                name="queryType"
                value="general"
                class="rounded-full"
                aria-invalid={Boolean(formErrors?.queryType)}
                aria-errormessage="fields.query.error"
              />
              <span>General Enquiry</span>
            </label>

            <label
              class="col-span-full flex items-center gap-2 rounded border border-gray-500 px-4 py-3 text-gray-900 sm:col-span-3 dark:text-white"
            >
              <input
                type="radio"
                id="fields.contract.input"
                name="queryType"
                value="contract"
                class="rounded-full"
                aria-invalid={Boolean(formErrors?.queryType)}
                aria-errormessage="fields.query.error"
              />
              <span>Contract Work</span>
            </label>

            <label
              class="col-span-full flex items-center gap-2 rounded border border-gray-500 px-4 py-3 text-gray-900 sm:col-span-3 dark:text-white"
            >
              <input
                type="radio"
                id="fields.support.input"
                name="queryType"
                value="support"
                class="rounded-full"
                aria-invalid={Boolean(formErrors?.queryType)}
                aria-errormessage="fields.query.error"
              />
              <span>Technical Support</span>
            </label>

            <label
              class="col-span-full flex items-center gap-2 rounded border border-gray-500 px-4 py-3 text-gray-900 sm:col-span-3 dark:text-white"
            >
              <input
                type="radio"
                id="fields.issues.input"
                name="queryType"
                value="issues"
                class="rounded-full"
                aria-invalid={Boolean(formErrors?.queryType)}
                aria-errormessage="fields.query.error"
              />
              <span>Bug Report</span>
            </label>
          </section>

          <span
            role="alert"
            aria-live="polite"
            aria-atomic="true"
            aria-relevant="all"
            class="inline-block text-sm text-red-400"
            id="fields.query.error"
          >
            {formErrors?.queryType?.join(" ")}
          </span>
        </fieldset>

        <div class="group col-span-full flex flex-col gap-2">
          <label
            for="fields.message.input"
            class="space-x-1 text-sm font-medium text-gray-600 dark:text-gray-100"
          >
            <span>Message</span>
            <span class="text-red-400">*</span>
          </label>
          <textarea
            name="message"
            id="fields.message.input"
            autocapitalize="on"
            class="min-h-32 rounded border border-gray-500 bg-transparent px-4 py-3 text-gray-900 dark:text-white"
            autocomplete="off"
            aria-invalid={Boolean(formErrors?.message)}
            aria-errormessage="fields.message.error"></textarea>
          <span
            role="alert"
            aria-live="polite"
            aria-atomic="true"
            aria-relevant="all"
            class="text-sm text-red-400"
            id="fields.message.error"
          >
            {formErrors?.message?.join(" ")}
          </span>
        </div>

        <div class="group col-span-full flex flex-col gap-2">
          <div class="flex items-center gap-2">
            <input
              type="checkbox"
              id="fields.consent.input"
              name="consent"
              class=""
              aria-invalid={Boolean(formErrors?.consent)}
              aria-errormessage="fields.email.error"
            />
            <label
              class="space-x-1 text-sm font-medium text-gray-600 dark:text-gray-100"
              for="fields.consent.input"
            >
              <span>I consent to being contacted by Sam</span>
              <span class="text-red-400">*</span>
            </label>
          </div>

          <span
            role="alert"
            aria-live="polite"
            aria-atomic="true"
            aria-relevant="all"
            class="text-sm text-red-400"
            id="fields.consent.error"
          >
            {formErrors?.consent?.join(" ")}
          </span>
        </div>

        <button
          type="submit"
          class="col-span-full rounded bg-blue-600 px-4 py-3 font-medium text-white transition-colors hover:bg-blue-700"
        >
          Submit
        </button>
      </section>
    </form>
  </Prose>
</Shell>

---
// Not.astro
import type { ComponentProps } from "astro/types";
import If from "./if.astro";

type Props = ComponentProps<typeof If>;

const { condition } = Astro.props;
---

<!--
  Not(condition) is If(!condition) with "true"/"false" slot roles swapped:
  content in the "true" slot here should render when `condition` is falsy,
  which is exactly what If's "true" slot does for `!condition`.
-->
<If condition={!condition}>
  <slot name="true" slot="true" />
  <slot name="false" slot="false" />
  <slot name="else" slot="else" />
  <slot slot="default" />
</If>

---
import Icon from "@/components/shared/icon.astro";

import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button">;
---

<ui-theme class="contents">
  <button
    type="button"
    title="Toggle Theme"
    class:list={[
      "group relative flex items-center p-3 text-2xl",
      "text-gray-900 dark:text-gray-200",
      "hover:text-gray-200 dark:hover:text-gray-900",
      "hover:bg-gray-900 dark:hover:bg-gray-200",
      "focus:text-gray-200 dark:focus:text-gray-900",
      "focus:bg-gray-900 dark:focus:bg-gray-200",
      Astro.props.class,
    ]}
  >
    <span class="sr-only">Toggle theme</span>
    <Icon
      data-id="ui-light"
      name="lucide:cloud-moon"
      role="presentation"
      class="text-inherit data-[hidden=true]:hidden"
      data-hidden="false"
    />
    <Icon
      data-id="ui-dark"
      name="lucide:sun"
      role="presentation"
      class="text-inherit data-[hidden=true]:hidden"
      data-hidden="false"
    />
    <Icon
      data-id="ui-system"
      name="lucide:monitor-cog"
      role="presentation"
      class="text-inherit data-[hidden=true]:hidden"
      data-hidden="false"
    />
  </button>
</ui-theme>

{/* Inlined to avoid FOUC. Uses global scope from `theme-provider.astro` */}
<script is:inline>
  Theme.selectThemeIcon();
</script>

<script>
  import { createElement } from "@/helpers/dom";

  type Theme = "system" | "light" | "dark";
  // type Theme = (typeof themes)[number];
  type ColorScheme = Exclude<Theme, "system">;
  const ThemeKey = "ui-theme";

  // const themes = ["system", "light", "dark"] as const;
  const ThemeMap = { system: "light", light: "dark", dark: "system" } as Record<Theme, Theme>;
  const mql = matchMedia("(prefers-color-scheme: light)");
  const channel = "BroadcastChannel" in globalThis ? new BroadcastChannel(ThemeKey) : null;

  // const nextTheme = (current: Theme): Theme => {
  //   const idx = themes.indexOf(current);
  //   return themes[(idx + 1) % themes.length]!;
  // };
  const nextTheme = (current: Theme) => ThemeMap[current];

  const getSystemScheme = (): ColorScheme => (mql.matches ? "light" : "dark");

  const parseTheme = (value: unknown): Theme =>
    value === "light" || value === "dark" ? value : "system";

  const loadTheme = (): Theme => parseTheme(localStorage?.getItem(ThemeKey));

  const storeTheme = (theme: Theme) => {
    localStorage?.setItem(ThemeKey, theme === "light" || theme === "dark" ? theme : "");
  };

  const resolveScheme = (theme: Theme): ColorScheme =>
    theme === "system" ? getSystemScheme() : theme;

  const root = document.documentElement;

  /** Update theme widget, document theme, and local storage state. */
  const setTheme = (theme: Theme) => {
    Theme.selectThemeIcon(theme);

    const scheme = resolveScheme(theme);
    root.dataset.theme = scheme;
    root.dataset.codeTheme = `github-${scheme}-default`;

    storeTheme(theme);
  };

  const onThemeChange = (theme: Theme) => {
    setTheme(theme);
    // oxlint-disable-next-line unicorn/require-post-message-target-origin
    channel?.postMessage({ theme, timestamp: Temporal.Now.instant().epochMilliseconds });
  };

  // ============================================================================
  // Cross-tab Synchronization
  // ============================================================================
  let lastBroadcast = 0;
  interface Message {
    theme: Theme;
    timestamp: number;
  }
  type ChannelEvent = MessageEvent<Message>;

  channel?.addEventListener("message", (event: ChannelEvent) => {
    const { theme, timestamp } = event.data;
    if (timestamp <= lastBroadcast) return;
    lastBroadcast = timestamp;
    setTheme(parseTheme(theme));
  });

  // React to changes in system color scheme.
  mql.addEventListener("change", () => {
    if (loadTheme() === "system") onThemeChange("system");
  });

  // Fallback for browsers without BroadcastChannel (rare but defensive)
  if (!channel) {
    globalThis.addEventListener("storage", (e) => {
      if (e.key === ThemeKey && e.newValue !== null) {
        setTheme(parseTheme(e.newValue));
      }
    });
  }

  createElement(
    "ui-theme",
    class UiTheme extends HTMLElement implements CustomElement {
      #ctrl?: AbortController;
      connectedCallback() {
        setTheme(loadTheme());
        this.#ctrl = new AbortController();
        this.addEventListener("click", this, { signal: this.#ctrl.signal });
      }

      disconnectedCallback() {
        this.#ctrl?.abort();
      }

      handleEvent(event: Event) {
        // @ts-expect-error: TS2349 - This is a known limitation with third-party types
        this[`on${event.type}` as keyof this](event);
      }

      // @ts-expect-error: TS2425 - 'UiTheme' defines onclick as instance member function
      override onclick() {
        onThemeChange(nextTheme(loadTheme()));
      }
    },
  );
</script>

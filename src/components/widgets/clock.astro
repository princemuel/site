<figure class="flex items-center gap-2">
  <figcaption class="shrink-0 text-xs text-gray-600 tabular-nums dark:text-gray-300">
    <data id="clock-offset">(UTC)</data>&nbsp;
    <time id="clock-digital" datetime="00:00:00" class="font-mono">00:00:00</time>
  </figcaption>

  <div
    id="clock-face"
    role="img"
    aria-label="Analogue clock"
    style="-hour:0;--minute:0;--second:0;--width:2px;"
    class="relative flex size-14 rotate-180 items-center justify-center rounded-full border border-gray-100 bg-gray-50 after:z-10 after:size-[5%] after:rounded-full after:border-[0.5px] after:bg-gray-100 sm:size-16 dark:border-gray-900 dark:bg-transparent"
  >
    <div class="handle h-1/5 w-0.5 rotate-[calc(var(--hour)*1deg)] bg-gray-400"></div>
    <div class="handle h-1/3 w-0.5 rotate-[calc(var(--minute)*1deg)] bg-gray-400/50"></div>
    <div class="handle h-2/5 w-[0.4px] rotate-[calc(var(--second)*1deg)] bg-blue-500"></div>
  </div>
</figure>

<style>
  .handle {
    position: absolute;
    top: 50%;
    left: calc(50% - var(--width) / 2);
    transform-origin: center 0;
  }
</style>

<script>
  import { $ } from "@/helpers/dom";

  // oxlint-disable-next-line max-params
  function toDeg(value: number, period: number, subUnit = 0, subUnitPeriod = 1) {
    return ((value / period + subUnit / (period * subUnitPeriod)) * 360).toString();
  }

  const face = $("#clock-face", HTMLDivElement);
  const digital = $("#clock-digital", HTMLTimeElement);
  const offset = $("#clock-offset", HTMLDataElement);

  const { timeZone } = new Intl.DateTimeFormat().resolvedOptions();
  const today = Temporal.Now.zonedDateTimeISO(timeZone);
  // Computed once on page load. If a DST transition occurs mid-session, the offset
  // label will be stale, but this resolves on the next page load or reload.
  const timeZoneOffset = today.offset;
  offset.value = timeZoneOffset;
  offset.textContent =
    timeZoneOffset === "+00:00"
      ? "(UTC)"
      : `(UTC ${timeZoneOffset.replace(/^(?<sign>[+-])0*(?<hours>\d+):00$/u, "$<sign>$<hours>")})`;

  let prevMin = -1;

  function tick() {
    const now = Temporal.Now.zonedDateTimeISO(timeZone);
    const hr = now.hour;
    const min = now.minute;
    const sec = now.second;

    // Round once, then derive both the machine-readable attribute and the
    // visible text from the same value so they can't disagree at a
    // rounding boundary (e.g. one showing :59 while the other shows :00).
    const rounded = now.toPlainTime().round({ smallestUnit: "second", roundingMode: "halfCeil" });
    digital.dateTime = rounded.toString({ smallestUnit: "second" });
    digital.textContent = rounded.toLocaleString();

    face.style.setProperty("--second", toDeg(sec, 60));
    if (min !== prevMin) {
      face.style.setProperty("--minute", toDeg(min, 60, sec, 60));
      face.style.setProperty("--hour", toDeg(hr % 12, 12, min, 60));
      prevMin = min;
    }
  }

  function scheduleTick() {
    tick();
    const msIntoSecond = Temporal.Now.instant().epochMilliseconds % 1000;
    setTimeout(scheduleTick, 1000 - msIntoSecond);
  }

  scheduleTick();
</script>

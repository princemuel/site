---
import Meta from "@/components/content/meta.astro";
import Fence from "@/components/layout/fence.astro";
import Footer from "@/components/layout/footer.astro";
import Header from "@/components/layout/header.astro";
import Link from "@/components/shared/link.astro";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import "@/global.css";
import type { ComponentProps } from "astro/types";
// oxlint-disable-next-line typescript/no-empty-interface
interface Props extends ComponentProps<typeof Meta> {}

const { meta, og, twitter } = Astro.props;
---

<!doctype html>
<html lang="en" class="scheme-light motion-safe:scroll-smooth dark:scheme-dark" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <Meta meta={meta} og={og} twitter={twitter} />
    <Font cssVariable="--font-family-sans" preload />
    <Font cssVariable="--font-family-accent" />
    <Font cssVariable="--font-family-mono" />
    <script is:inline src="/assets/theme.js"></script>
    <script src="@/polyfills/temporal.ts"></script>
    <script src="@/assets/scripts/css-naked-day.ts"></script>
    <ClientRouter />
  </head>
  <body
    class:list={[
      "relative grid min-h-svh grid-rows-[auto_1fr_auto]",
      "overflow-auto font-sans text-base font-normal tracking-tight antialiased",
      "bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-50",
    ]}
  >
    <Link href="/website" rel="nofollow" hidden>Don't follow this link</Link>
    <!-- <Link href="#a11ty-headline" class="sr-only focus:not-sr-only">Skip to Content</Link> -->

    <Header />
    <Fence as="main" aria-labelledby="a11ty-headline" class="py-12">
      <slot />
    </Fence>
    <Footer />
  </body>
</html>

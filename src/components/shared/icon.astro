---
/**
 * Icon.astro
 *
 * A thin wrapper that resolves an "collection:name" string to the matching
 * Astro SVG component (imported from the generated index.ts).
 *
 * Astro treats imported .svg files as components, so each one already
 * accepts standard SVG attributes.  We layer a small set of convenience props
 * on top (size, class) and forward everything else via `...rest`.
 *
 * Usage:
 *   <Icon name="lucide:house" />
 *   <Icon name="arrow-right" />
 *   <Icon name="ion:logo-github" size={20} class="text-gray-400" />
 *   <Icon name="lucide:cloud-moon" aria-hidden="true" />
 */

import { icons, type iconNames } from "@/assets/media/icons";
import { IconCache } from "@/lib/cache";
import { invariant } from "@/utils/error";
import { getIconData, iconToSVG } from "@iconify/utils";
import type { HTMLAttributes } from "astro/types";

type IconName = (typeof iconNames)[number];

type SVGAttributes = HTMLAttributes<"svg">;

interface Props extends SVGAttributes {
  name: IconName;
  title?: string;
  desc?: string;
  size?: number | string;
  width?: number | string;
  height?: number | string;
  "is:inline"?: boolean;
}

const { name, title, desc, size, width, height, "is:inline": inlined, ...rest } = Astro.props;

const [iconSet, iconName] = (() => {
  const [first, second] = (name as string).split(":", 2);
  return second === undefined ? ["local", first] : [first, second];
})();

const collection = icons[iconSet!];

invariant(
  collection,
  `[Icon] Unknown icon set "${iconSet}". Did you run the bootstrap:icons script?`,
);
invariant(iconName, "[Icon] invalid value `%s` for icon name", typeof iconName);

const iconData = getIconData(collection, iconName);
invariant(
  iconData,
  `[Icon] "${iconName}" not found in "${iconSet}". Is it listed in icons/manifest.json?`,
);

const id = `${iconSet}:${iconName}`;
// In SSR mode, each unique icon is rendered as a <symbol> once per request.
// Every subsequent use emits only a <use href="#id">, avoiding repeating
// the full SVG body (which can be 1–3 KB) for common icons like "home".
const isInline = inlined ?? Astro.isPrerendered;

let isFirstRenderInRequest = true;
if (!isInline) {
  const req = Astro.request;
  const seen = IconCache.getOrInsertComputed(req, () => new Set());
  isFirstRenderInRequest = !seen.has(id);
  seen.add(id);
}

const useSymbol = !isInline && isFirstRenderInRequest;

const { attributes, body } = iconToSVG(iconData);
const { viewBox, ...attributesWithoutViewBox } = attributes;

const attrs = {
  ...(useSymbol ? attributesWithoutViewBox : attributes),
  ...rest,
  width: (size ?? width ?? attributes.width ?? "1em").toString(),
  height: (size ?? height ?? attributes.height ?? "1em").toString(),
};
---

<svg {...attrs}>
  {title && <title>{title}</title>}
  {desc && <desc>{desc}</desc>}
  {
    isInline ? (
      <Fragment set:html={body} />
    ) : (
      <Fragment>
        {useSymbol && <symbol id={id} viewBox={viewBox} set:html={body} />}
        <use href={`#${id}`} />
      </Fragment>
    )
  }
</svg>

---
import { invariant } from "@/utils/error";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

invariant(Astro.props.href, "Expected `href` to be set but got `%s`", typeof Astro.props.href);

const href = Astro.props.href.toString();

const is_internal = href.startsWith("#") || (href.startsWith("/") && !href.startsWith("//"));
const attrs = is_internal
  ? { ...Astro.props, href: new URL(href, Astro.site), "data-astro-prefetch": true }
  : { ...Astro.props, target: "_blank", rel: "noopener noreferrer external" };
---

<a {...attrs}><slot /></a>

<style>
  a[rel~="external"] {
    --icon-leave-page: 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="14" height="14"><path fill="%23111" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/><path fill="%23111" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/></svg>';
  }

  @media (prefers-color-scheme: dark) {
    a[rel~="external"] {
      --icon-leave-page: 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="14" height="14"><path fill="white" d="M8.636 3.5a.5.5 0 0 0-.5-.5H1.5A1.5 1.5 0 0 0 0 4.5v10A1.5 1.5 0 0 0 1.5 16h10a1.5 1.5 0 0 0 1.5-1.5V7.864a.5.5 0 0 0-1 0V14.5a.5.5 0 0 1-.5.5h-10a.5.5 0 0 1-.5-.5v-10a.5.5 0 0 1 .5-.5h6.636a.5.5 0 0 0 .5-.5z"/><path fill="white" d="M16 .5a.5.5 0 0 0-.5-.5h-5a.5.5 0 0 0 0 1h3.793L6.146 9.146a.5.5 0 1 0 .708.708L15 1.707V5.5a.5.5 0 0 0 1 0v-5z"/></svg>';
    }
  }
  a[rel~="external"]::after {
    content: url(var(--icon-leave-page));
    display: inline-block;
    margin-left: 4px;
    opacity: 0.6;
    transition: opacity 0.2s ease;
  }

  a[rel~="external"]:hover::after {
    opacity: 1;
  }
</style>

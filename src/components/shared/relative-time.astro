---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"time"> {
  datetime: string;
  format?: Intl.RelativeTimeFormatOptions;
  /** Re-render periodically while mounted. Default true. */
  live?: Booleanish;
}

const { datetime, format, live = true, ...attrs } = Astro.props;

const instant = Temporal.Instant.from(datetime);
const fallback = new Intl.DateTimeFormat(undefined, {
  dateStyle: "short",
  timeStyle: "short",
}).format(instant);
---

<relative-time
  role="time"
  datetime={datetime}
  data-format={format ? JSON.stringify(format) : undefined}
  data-live={live}
  {...attrs}
>
  {fallback}
</relative-time>

<script>
  import { createElement } from "@/helpers/dom";

  const UNITS: [Intl.RelativeTimeFormatUnit, number][] = [
    ["year", 60 * 60 * 24 * 365],
    ["month", 60 * 60 * 24 * 30],
    ["week", 60 * 60 * 24 * 7],
    ["day", 60 * 60 * 24],
    ["hour", 60 * 60],
    ["minute", 60],
    ["second", 1],
  ];

  createElement(
    "relative-time",
    class RelativeTimeElement extends HTMLElement implements CustomElement {
      static observedAttributes = ["datetime", "data-format"];
      #timer?: ReturnType<typeof setTimeout>;
      #Intl: Intl.RelativeTimeFormat | null = null;

      connectedCallback() {
        document.addEventListener("visibilitychange", this.#onVisibilityChange);
        this.#render();
      }

      disconnectedCallback() {
        clearTimeout(this.#timer);
        document.removeEventListener("visibilitychange", this.#onVisibilityChange);
      }

      attributeChangedCallback(name: string) {
        if (name === "data-format") this.#Intl = null;
        this.#render();
      }

      #render() {
        clearTimeout(this.#timer);

        const datetime = this.getAttribute("datetime");
        if (!datetime) return;

        let target: Temporal.Instant | null = null;
        try {
          target = Temporal.Instant.from(datetime);
        } catch {
          return;
        }

        const seconds = Temporal.Now.instant().since(target).total("seconds");
        const [unit, unitSecs] = UNITS.find((u) => Math.abs(seconds) >= u[1]) ?? UNITS.at(-1)!;

        this.textContent = this.#formatter().format(Math.round(-seconds / unitSecs), unit);

        if (this.dataset.live === "true") {
          const remInUnit = Math.abs(seconds) % unitSecs;
          const secsTillNextTick = unitSecs - remInUnit;
          const delay = Math.min(Math.max(secsTillNextTick, 1), 3600) * 1000;

          this.#timer = setTimeout(() => this.#render(), delay);
        }
      }

      #onVisibilityChange = () => {
        if (document.hidden) {
          clearTimeout(this.#timer);
        } else {
          this.#render();
        }
      };

      #formatter(): Intl.RelativeTimeFormat {
        if (this.#Intl) return this.#Intl;

        const options: Intl.RelativeTimeFormatOptions = this.dataset.format
          ? (JSON.parse(this.dataset.format) as Intl.RelativeTimeFormatOptions)
          : { numeric: "auto" };

        this.#Intl = new Intl.RelativeTimeFormat(navigator.language, options);
        return this.#Intl;
      }
    },
  );
</script>

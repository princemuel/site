---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"time"> {
  datetime: string;
  format?: Intl.DateTimeFormatOptions;
}

const { datetime, format, ...attrs } = Astro.props;

const instant = Temporal.Instant.from(datetime);
const fallback = new Intl.DateTimeFormat(undefined, {
  dateStyle: "short",
  timeStyle: "short",
}).format(instant);
---

<local-time
  role="time"
  datetime={datetime}
  data-format={format ? JSON.stringify(format) : undefined}
  {...attrs}
>
  {fallback}
</local-time>

<script>
  import { createElement } from "@/helpers/dom";

  createElement(
    "local-time",
    class LocalTimeElement extends HTMLElement implements CustomElement {
      static observedAttributes = ["datetime", "data-format"];
      #Intl: Intl.DateTimeFormat | null = null;

      connectedCallback() {
        this.#render();
      }

      attributeChangedCallback(name: string) {
        if (name === "data-format") this.#Intl = null;
        this.#render();
      }

      disconnectedCallback() {
        this.#Intl = null;
      }

      #render() {
        const datetime = this.getAttribute("datetime");
        if (!datetime) return;

        let target: Temporal.Instant | null = null;
        try {
          target = Temporal.Instant.from(datetime);
        } catch {
          return;
        }

        this.textContent = this.#formatter().format(target);
      }

      #formatter(): Intl.DateTimeFormat {
        if (this.#Intl) return this.#Intl;

        const raw = this.dataset.format;
        const options: Intl.DateTimeFormatOptions = raw
          ? (JSON.parse(raw) as Intl.DateTimeFormatOptions)
          : { dateStyle: "short", timeStyle: "short" };
        options.timeZone = Temporal.Now.timeZoneId();
        this.#Intl = new Intl.DateTimeFormat(navigator.language, options);
        return this.#Intl;
      }
    },
  );
</script>
